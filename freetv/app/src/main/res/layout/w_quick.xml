<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/w_bg">
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FreeTV"
            android:textColor="#FFC4B5FD" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end" android:text="Your TV, one tap away" android:textColor="#A6FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_theme" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal" android:padding="4dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/w_round" android:padding="11dp" android:src="@drawable/f_spark" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Next look" android:textColor="#D9FFFFFF" android:textSize="11.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_saver" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal" android:padding="4dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/w_key" android:padding="11dp" android:src="@drawable/f_moon" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Screensaver" android:textColor="#D9FFFFFF" android:textSize="11.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_qhome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal" android:padding="4dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/w_key" android:padding="11dp" android:src="@drawable/f_home" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Home" android:textColor="#D9FFFFFF" android:textSize="11.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_free" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal" android:padding="4dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/w_key" android:padding="11dp" android:src="@drawable/g_chip" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Free RAM" android:textColor="#D9FFFFFF" android:textSize="11.5sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
